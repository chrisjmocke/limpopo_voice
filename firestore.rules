rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Personal user profile data: only the user may read/write.
    match /users/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    // Optional user sub-documents keep same ownership model.
    match /users/{userId}/{document=**} {
      allow read, write: if isSelf(userId);
    }

    // Payment telemetry events. Allow only self-owned creates from client.
    match /payment_events/{eventId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Global device tracking for free trial abuse prevention.
    match /global_device_installs/{deviceId} {
      allow read, write: if signedIn();
    }

    // Shared caches for translations and audio.
    match /cache_translations/{cacheKey} {
      allow read, write: if signedIn();
    }
    match /cache_audio/{cacheKey} {
      allow read, write: if signedIn();
    }
  }
}
