rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow devices to manage their own install / free-trial record.
    match /global_device_installs/{deviceId} {
      allow read, write: if true;
    }

    // Shared caches are read/written by signed-in users.
    match /translation_cache/{cacheId} {
      allow read, write: if request.auth != null;
    }

    match /tts_audio_cache/{document=**} {
      allow read, write: if request.auth != null;
    }

    // User-owned account data: credits, history, deferred audio, and future profile data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
