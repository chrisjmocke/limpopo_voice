rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow devices to manage their own install / free-trial record.
    match /global_device_installs/{deviceId} {
      allow read, write: if true;
    }

    // Allow authenticated users to use the shared translation cache.
    match /translation_cache/{cacheId} {
      allow read, write: if request.auth != null;
    }

    // User data paths
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Match all subcollections under the user document (like history, credits, deferred audio)
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Allow authenticated users to read and write to the global audio cache
    match /tts_audio_cache/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
