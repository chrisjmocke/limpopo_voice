rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incomingData() {
      return request.resource.data;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId) && (
        // Ensure balance and credits are numbers and non-negative, and respect up to 3 tiers
        (
          (!('creditBalance' in incomingData()) || (incomingData().creditBalance is number && incomingData().creditBalance >= 0)) &&
          (!('credits' in incomingData()) || (incomingData().credits is number && incomingData().credits >= 0)) &&
          (!('tierLevel' in incomingData()) || (incomingData().tierLevel is number && incomingData().tierLevel >= 0 && incomingData().tierLevel <= 3))
        )
      );

      match /device_installs/{installId} {
        allow read, write: if isOwner(userId);
      }

      match /transactions/{transactionId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /translation_cache/{cacheId} {
      allow read, write: if isAuthenticated();
    }

    match /tts_audio_cache/{cacheId} {
      allow read, write: if isAuthenticated();
    }

    match /global_device_installs/{deviceId} {
      // Allow any client to look up or write a device install to enforce the 10 credit free trial
      allow read: if true;
      allow create, update: if request.resource.id == deviceId
        && incomingData().used_free_trial is bool
        && (!('credits' in incomingData()) || (incomingData().credits is number && incomingData().credits >= 0));
    }
  }
}
