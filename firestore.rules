rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Personal user profile data
    match /users/{userId} {
      allow read, create, update, delete: if isSelf(userId);
    }

    // User sub-documents
    match /users/{userId}/{document=**} {
      allow read, write: if isSelf(userId);
    }

    // Payment telemetry events (Write-only for owner, tamper-proof)
    match /payment_events/{eventId} {
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    // Global device tracking (Prevent client overwrites/deletes)
    match /global_device_installs/{deviceId} {
      allow read: if signedIn();
      // Allow creation only if document does not exist yet (prevents overwrite)
      allow create: if signedIn() && !exists(/databases/$(database)/documents/global_device_installs/$(deviceId));
      allow update, delete: if false;
    }

    // Shared caches (Read-only for clients; writes managed by server/Cloud Functions)
    match /cache_translations/{cacheKey} {
      allow read: if signedIn();
      allow write: if false; // Cloud Functions with Admin SDK handle writes
    }
    
    match /cache_audio/{cacheKey} {
      allow read: if signedIn();
      allow write: if false; // Cloud Functions with Admin SDK handle writes
    }
  }
}
